# Dependencias
node_modules/

# El entorno del motor. NO se versiona ni se copia entre máquinas: lleva rutas
# absolutas horneadas en pyvenv.cfg y en los shebang, así que moverlo lo rompe.
bot-engine/venv/
__pycache__/
*.pyc

# Salida y estado del perfil de ejemplo (los perfiles reales viven en /srv).
bot-engine/perfiles/*/data/catalogo.pdf
bot-engine/perfiles/*/data/.pdf-thumbs/
bot-engine/perfiles/*/data/estado-bot.json
bot-engine/perfiles/*/data/transcripciones.json
bot-engine/perfiles/*/data/reenganches.json
bot-engine/perfiles/*/data/citas.json
bot-engine/perfiles/*/data/eventos.jsonl

# Salida de build del panel. Se regenera con `npm run panel` desde server/,
# y el propio proceso la borra y la rehace en cada compilación.
server/public/

# SECRETOS. La clave del panel se genera en la instalación y vive solo en el
# servidor, con permisos 600.
instalacion/clave-panel.txt
# Credenciales SMTP con las que los Chatsuites de los clientes mandan correo.
instalacion/panel.env
.env
.env.*
*.pem
*.key

# Datos de los clientes: viven en /srv/chatsuite/, nunca en el repo.
tenants.json

# Ruido
*.log
.DS_Store
